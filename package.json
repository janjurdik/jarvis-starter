{
  "name": "jarvis-starter",
  "version": "1.10.2",
  "private": true,
  "type": "module",
  "description": "Jarvis: osobný AI asistent s vlastnou pamäťou, HUD na ploche a rutinami. Základ, ktorý si každý dostavia po svojom, na Claude alebo ChatGPT.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node hud/server.mjs",
    "hud": "node scripts/hud.mjs",
    "doctor": "node scripts/doctor.mjs",
    "routine": "node scripts/routine.mjs",
    "schedule": "node scripts/schedule.mjs",
    "autostart": "node scripts/autostart.mjs",
    "scan": "node scripts/scan.mjs",
    "import": "node scripts/import.mjs",
    "pulse": "node scripts/pulse.mjs",
    "update": "node scripts/update.mjs",
    "release": "node scripts/release.mjs",
    "call": "node scripts/call.mjs",
    "setup": "node scripts/setup.mjs",
    "orb": "node scripts/orb.mjs",
    "suggest": "node scripts/suggest.mjs",
    "alarm": "node scripts/alarm.mjs",
    "media": "node scripts/media.mjs",
    "voice": "node scripts/voice.mjs",
    "activity": "node scripts/activity.mjs",
    "garmin": "node scripts/garmin.mjs",
    "test": "node --test test/*.test.mjs scripts/test/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "three": "0.187.0",
    "ws": "8.22.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janjurdik/jarvis-starter.git"
  }
}
