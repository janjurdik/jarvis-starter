# Jarvis: voliteľné nastavenia. Skopíruj tento súbor ako `.env` a uprav, čo potrebuješ.
# Bez súboru .env beží všetko s predvolenými hodnotami. Žiadne API kľúče nie sú potrebné:
# Jarvis používa tvoje predplatné Claude cez Claude Code.

# Port HUD (http://localhost:4545)
# PORT=4545

# Na akej AI Jarvis beží: claude (Claude Code), codex (ChatGPT cez Codex) alebo antigravity (Gemini cez Antigravity).
# Bez tohto riadku tá, v ktorej si napísal štart.
# JARVIS_AI=claude
# JARVIS_CODEX_MODEL=        # model pre Codex, bez nastavenia tvoj predvolený
# JARVIS_ANTIGRAVITY_MODEL=  # model hlasového mozgu na Antigravity (napríklad gemini-3.8-flash), bez nastavenia predvolený
# JARVIS_ANTIGRAVITY_EFFORT=low   # úroveň premýšľania na Antigravity: low, medium, high
# JARVIS_ANTIGRAVITY_BIN=    # cesta k agy, keď ho Jarvis nenájde sám (docs/MODELY.md)

# Prehliadač: úlohy na pozadí smú pracovať v tvojom Chrome cez rozšírenie Claude in Chrome (docs/OVLADANIE.md). 0 = vypnúť
# JARVIS_CHROME=0

# Model hlasového mozgu v HUD: sonnet (predvolené, rýchly), opus (múdrejší, pomalší), haiku (najrýchlejší)
# JARVIS_MODEL=sonnet

# Model pre rutiny a úlohy na pozadí (bez nastavenia tvoj predvolený model v Claude Code)
# JARVIS_JOB_MODEL=opus

# Jazyk reči: sk alebo cs. Bez tohto riadku platí "language" v config/jarvis.json.
# JARVIS_LANG=sk

# Hlas Jarvisa (Microsoft Edge TTS, zadarmo, potrebuje nainštalované `uv`).
# Hlas, meno a to, či Jarvis hovorí ako muž alebo žena, sa nastavujú v nastaveniach HUD
# (ukladajú sa do config/jarvis.json: "assistant" a "voice") alebo vetou „hovor ženským hlasom".
# Tento riadok platí len vtedy, keď v config/jarvis.json nie je vybraný hlas ("voice.id").
# Slovenské hlasy: sk-SK-LukasNeural, sk-SK-ViktoriaNeural. České: cs-CZ-AntoninNeural, cs-CZ-VlastaNeural.
# JARVIS_EDGE_VOICE=sk-SK-LukasNeural
# Rýchlosť reči a výška hlasu:
# JARVIS_EDGE_RATE=+4%
# JARVIS_EDGE_PITCH=-2Hz
# Čím Jarvis hovorí: edge | browser | say (macOS) | elevenlabs | off
# JARVIS_TTS=edge

# Keď nie je otvorené okno HUD, Jarvis povie pripomienky a výsledky rutín cez reproduktory počítača.
# 0 = len oznámenie na obrazovke. Budík hovorí nahlas vždy.
# JARVIS_LOCAL_VOICE=1

# Budík: na čas budenia Jarvis zvýši na Macu stlmenú alebo veľmi tichú hlasitosť na toto percento a potom ju vráti. 0 = hlasitosť nemeniť.
# JARVIS_ALARM_VOLUME=50

# Rozpoznávanie reči (podrobnosti v docs/HLAS.md):
#   auto    = predvolené: lokálny Whisper, keď ho počítač utiahne (podľa pamäte, procesora, grafickej
#             karty a voľného miesta na disku), inak prehliadač. Model sa stiahne pred prvým otvorením HUD.
#   whisper = lokálny Whisper aj na slabšom počítači
#   mlx     = lokálny Whisper na Macu s Apple Silicon
#   faster  = lokálny Whisper na Windows, Linuxe a starších Macoch
#   browser = Chrome alebo Edge, nič sa nesťahuje
#   off     = hlasové ovládanie vypnuté
# Bez tohto riadku platí "stt" v config/jarvis.json (auto, browser alebo whisper).
# JARVIS_STT=auto
# Model Whispera namiesto automatického výberu: large-v3-turbo (1,6 GB), medium (1,5 GB), small (0,5 GB), base (0,15 GB)
# JARVIS_WHISPER_MODEL=small
# Nepoužívať grafickú kartu NVIDIA:
# JARVIS_WHISPER_DEVICE=cpu
# Kam sa modely sťahujú (predvolene ~/.cache/jarvis/models, na Windows %LOCALAPPDATA%\Jarvis\models):
# JARVIS_MODELS_DIR=
# Koľko sekúnd smie prvý štart čakať na prípravu hlasu, potom sťahovanie pokračuje na pozadí:
# JARVIS_PREPARE_WAIT_S=900

# Kalendár: tajná adresa vo formáte iCal (Google Kalendár → Nastavenia kalendára → Tajná adresa vo formáte iCal).
# Viac adries oddeľ čiarkou. Je to tajný údaj, patrí len sem.
# CALENDAR_ICS_URL=

# Pamäť v inom priečinku (napríklad tvoj Obsidian vault)
# JARVIS_MEMORY_DIR=

# ElevenLabs hlas (len ak nastavíš JARVIS_TTS=elevenlabs)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Hovory: Jarvis ti vie zavolať na mobil cez tvoj účet Twilio (postup v docs/HOVORY.md).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=              # tvoje číslo v Twiliu, +1… alebo +421…
# JARVIS_CALL_TO=           # tvoj mobil, +421…
# JARVIS_CALL_VOICE=Google.sk-SK-Wavenet-B
# JARVIS_CALL_REPLY=1       # 0 = po správe nečakať na odpoveď hlasom
# JARVIS_CALL_MAX_PER_DAY=12

# HUD otvorený do domácej siete (HUD_HOST=0.0.0.0): mená, pod ktorými smie odpovedať, oddelené čiarkou.
# Z iného zariadenia treba vždy aj hlavičku x-hud-token (hodnota je v data/brain/token).
# JARVIS_ALLOWED_HOSTS=

# Aktualizácie: 0 vypne kontrolu novej verzie. Iný zdroj aktualizácií (tvoj fork): owner/repo
# JARVIS_UPDATE_CHECK=1
# JARVIS_UPDATE_REPO=janjurdik/jarvis-starter
# JARVIS_UPDATE_BRANCH=main

# Videá (docs/VIDEO.md): najdlhšie video v minútach, najväčší súbor v MB, výška obrazu a koľko videí ostáva na disku.
# JARVIS_VIDEO_MAX_MIN=180
# JARVIS_VIDEO_MAX_MB=1500
# JARVIS_VIDEO_HEIGHT=720
# JARVIS_VIDEO_KEEP=6
# JARVIS_VIDEO_CACHE_GB=6
# Vlastný prepis videa bez titulkov (len s lokálnym Whisperom) najviac do tejto dĺžky v minútach.
# JARVIS_VIDEO_WHISPER_MAX_MIN=60

# Budík: pesnička, ktorá sa stiahne pri nastavení, a koľko sekúnd hrá, kým Jarvis začne hovoriť.
# JARVIS_ALARM_SONG_URL=https://www.youtube.com/watch?v=l482T0yNkeo
# JARVIS_ALARM_SOUND_SEC=45

# yt-dlp sa spúšťa cez uv v overenej verzii. Iná verzia, alebo vlastný program v počítači (system = z PATH).
# JARVIS_YTDLP_VERSION=
# JARVIS_YTDLP_BIN=
# JARVIS_YTDLP_AUTOUPDATE=1
